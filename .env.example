# Copy to .env and fill in. Never commit .env (it is git-ignored).

# --- LLM: Azure OpenAI is the default; OpenAI is used if Azure is not configured ---
AZURE_OPENAI_API_KEY=
# Any form from the portal works; only the host is used (we call <host>/openai/v1/).
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com
# The *deployment name* you chose in the portal (not the model name).
AZURE_OPENAI_DEPLOYMENT=copilot-chat
# Leave AZURE_OPENAI_API_VERSION unset: the v1 endpoint needs no version. Only set a real one
# (e.g. 2024-10-21) to use the older dated API instead.
# AZURE_OPENAI_API_VERSION=
# Optional: an Azure embedding deployment (otherwise RAG uses the offline local model).
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Fallback provider
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional overrides
# LLM_PROVIDER=openai          # force "openai" or "azure"
# EMBEDDING_PROVIDER=local     # "local" = offline MiniLM model, no API key needed for RAG
# DATABASE_URL=sqlite:///data/sales.db
